---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectList from '@/components/sections/ProjectList.astro';
import { getProjects } from '@/lib/projects';
import { SITE } from '@/config/site';

const projects = await getProjects();
---

<BaseLayout
  title={`Proyectos — ${SITE.name}`}
  description="Branding, sitios web y contenido para redes sociales: una selección de proyectos de Bear Estudio."
  tone="dark"
  current="proyectos"
>
  <ProjectList projects={projects} headingTag="h1" />
</BaseLayout>
